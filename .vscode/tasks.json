{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-backend-env",
      "type": "shell",
      "command": "& '${workspaceFolder}\\scripts\\prepare-backend-env.ps1' -Port 8082",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
